{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XepThoiKhoaBieu",
  "version": "1.1.0",
  "identifier": "vn.thcsvinhphuoc.xeptkb",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Xếp thời khóa biểu",
        "width": 1366,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Nguyen Duy Tan",
    "copyright": "Tác giả: Nguyễn Duy Tân – GV trường THCS Vĩnh Phước, TP Cần Thơ",
    "shortDescription": "Xếp thời khóa biểu offline",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
